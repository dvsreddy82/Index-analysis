# Copy to .env (git-ignored) and fill in. Loaded by config.py at startup.
# Shoonya (Finvasia) API — read-only market data. From trade.shoonya.com -> Profile -> API Key.
SHOONYA_USER_ID=
SHOONYA_CLIENT_ID=
SHOONYA_SECRET=
# Optional: base32 TOTP key, so the sign-in window can show the current 6-digit code
SHOONYA_TOTP_KEY=

# Local LLM (AI coach) — optional
# AI_MODEL=qwen3:14b
# OLLAMA_HOST=http://127.0.0.1:11434
